# Purpose: Shared editor defaults for this repository.
# Scope: UTF-8, LF line endings, two-space indentation, final newlines, and trimmed whitespace.
# Does NOT belong: Formatting rules Prettier owns (.prettierrc.json).
# Copyright (c) 2026 William Carson McRae. All rights reserved.
# SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
