---
/**
 * Purpose: Server-rendered chronological content and progressive timeline entry point.
 * Scope: A complete year-grouped no-JavaScript feed, controls, and accessible notices.
 * Does NOT belong: The date rail or browsing behavior (src/lib/timeline-controller.ts).
 */
import { timelinePosts } from '../data/timeline';
import { groupMoments, chronological } from '../lib/timeline-model';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import TimelineControls from './TimelineControls.astro';
import ActionNotice from './ActionNotice.astro';
import DateRail from './DateRail.astro';
const groups = groupMoments(timelinePosts, 'years');
---

<section
  class="timeline-feed"
  id="timeline"
  aria-label="Carson’s timeline"
  data-timeline
  data-view="timeline"
>
  <div class="timeline-dock enhancement">
    <DateRail />
    <TimelineControls />
  </div>
  <div class="timeline-empty" data-timeline-empty hidden tabindex="-1"></div>
  <div class="timeline-groups" data-timeline-groups>
    {groups.map((group) => (
      <section class="moment-group" data-period={group.key} data-period-date={group.date}>
        <h2 tabindex="-1">{group.label}</h2>
        <div class="moment-group__cards">
          {group.items.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    ))}
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-timeline-status></p>
</section>
<ActionNotice />
<div class="timeline-jumps enhancement" role="group" aria-label="Timeline shortcuts">
  <button
    class="timeline-jumps__up"
    data-timeline-edge="newest"
    data-jump-date={chronological(timelinePosts)[0]!.date}
    aria-label="Top of timeline, newest moment"
  >
    <Icon name="chevron" />
  </button>
  <button
    data-timeline-edge="oldest"
    data-jump-date={chronological(timelinePosts).at(-1)!.date}
    aria-label="Bottom of timeline, oldest moment"
  >
    <Icon name="chevron" />
  </button>
</div>
<script>
  import '../scripts/site';
  import { initTimeline } from '../lib/timeline-controller';
  initTimeline(document, window);
  if (history.state?.scrollY > 0)
    window.scrollTo({ top: history.state.scrollY, behavior: 'instant' });
  document.documentElement.removeAttribute('data-timeline-restore');
</script>
