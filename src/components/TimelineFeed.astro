---
/**
 * Purpose: Server-rendered chronological content and progressive timeline entry point.
 * Scope: Native annual reading groups, pre-rendered enhanced monthly groups, controls, and notices.
 * Does NOT belong: The date rail or browsing behavior (src/lib/timeline-controller.ts).
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import { timelinePosts } from '../data/timeline';
import { groupMoments, chronological } from '../lib/timeline-model';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import TimelineControls from './TimelineControls.astro';
import ActionNotice from './ActionNotice.astro';
import DateRail from './DateRail.astro';
import MomentNavigator from './MomentNavigator.astro';
import '../styles/timeline-initial.css';
const groups = groupMoments(timelinePosts, 'years');
---

<section
  class="timeline-feed"
  id="timeline"
  aria-label="Carson’s timeline"
  data-timeline
  data-view="timeline"
  data-detail="months"
>
  <div class="timeline-dock enhancement">
    <DateRail />
    <TimelineControls />
    <div class="timeline-jumps enhancement">
      <button
        class="timeline-jumps__up"
        data-timeline-edge="newest"
        data-jump-date={chronological(timelinePosts)[0]!.date}
        aria-label="Top of timeline, newest moment"
        hidden
      >
        <Icon name="chevron" />
      </button>
    </div>
  </div>
  <div class="timeline-empty" data-timeline-empty hidden tabindex="-1"></div>
  <div class="timeline-groups" data-timeline-groups>
    {groups.map((group) => (
      <section class="moment-group moment-group--year">
        <h2 tabindex="-1">{group.label}</h2>
        <div>
          {groupMoments(group.items, 'months').map((month) => (
            <section class="moment-group">
              <h2 tabindex="-1">{month.label}</h2>
              <div>
                {month.items.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    ))}
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-timeline-status>
    {timelinePosts.length} moments. Timeline view. All categories.
  </p>
</section>
<ActionNotice />
<MomentNavigator />
<div class="timeline-jumps enhancement">
  <button
    data-timeline-edge="oldest"
    data-jump-date={chronological(timelinePosts).at(-1)!.date}
    aria-label="Bottom of timeline, oldest moment"
    hidden
  >
    <Icon name="chevron" />
  </button>
</div>
<script>
  import { startPostActions } from '../scripts/actions';
  import { initDeferredTimeline } from '../lib/timeline-loader';
  startPostActions();
  await document.fonts.ready;
  initDeferredTimeline(document, window);
</script>
