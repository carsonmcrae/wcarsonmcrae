---
/**
 * Purpose: The approved image associated with a timeline moment.
 * Scope: Responsive local photography and project artwork, optimized by Astro.
 * Does NOT belong: Photo approval, imports, captions, or card layout.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import { Image } from 'astro:assets';
import { getPhoto, getProjectImage } from '../lib/images';
interface Props {
  name: string;
  alt: string;
  kind?: 'photo' | 'project' | 'screen';
  eager?: boolean;
  sizes?: string;
  widths?: number[];
}
const { name, alt, kind = 'photo', eager = false, sizes, widths } = Astro.props;
const source = kind === 'photo' ? getPhoto(name) : getProjectImage(name);
---

{source && (
  <Image
    src={source}
    alt={alt}
    width={kind === 'project' ? 192 : 800}
    widths={widths ?? (kind === 'project' ? [96, 192, 288] : [320, 640, 800])}
    sizes={sizes ?? (kind === 'project' ? '96px' : '(min-width: 64rem) 800px, 95vw')}
    format="webp"
    quality={78}
    loading={eager ? 'eager' : 'lazy'}
  />
)}
