---
/**
 * Purpose: The approved image associated with a timeline moment.
 * Scope: Responsive local photography and project artwork, optimized by Astro.
 * Does NOT belong: Photo approval, imports, captions, or card layout.
 */
import { Image } from 'astro:assets';
import { getPhoto, getProjectImage } from '../lib/images';
interface Props {
  name: string;
  alt: string;
  kind?: 'photo' | 'project';
  eager?: boolean;
}
const { name, alt, kind = 'photo', eager = false } = Astro.props;
const source = kind === 'photo' ? getPhoto(name) : getProjectImage(name);
---

{source && (
  <Image
    src={source}
    alt={alt}
    width={kind === 'photo' ? 800 : 192}
    widths={kind === 'photo' ? [320, 640, 800] : [96, 192, 288]}
    sizes={kind === 'photo' ? '(min-width: 64rem) 800px, 95vw' : '96px'}
    format="webp"
    quality={78}
    loading={eager ? 'eager' : 'lazy'}
    data-moment-image={name}
  />
)}
