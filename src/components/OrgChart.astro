---
/**
 * Purpose: A custom household organization diagram with a visible, semantic text equivalent.
 * Scope: Approved management, staff, and responsibilities in responsive HTML with SVG connectors.
 * Does NOT belong: Household facts (src/data/life.ts), substitute portraits, or interaction logic.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import { dogs, orgChart } from '../data/life';
import Icon from './Icon.astro';
import '../styles/household-chart.css';
---

<figure class="org" aria-labelledby="household-chart-title">
  <figcaption class="org__heading">
    <span class="org__eyebrow">At home</span>
    <h3 id="household-chart-title">{orgChart.title}</h3>
  </figcaption>
  <div class="org__diagram">
    <div class="org__tier org__tier--management">
      <p class="org__tier-label">Management</p>
      <ul class="org__row" role="list">
        {dogs.map((dog) => (
          <li class="org__person org__person--management">
            <span class="org__seal" aria-hidden="true">
              <Icon name="life" />
            </span>
            <h4>{dog.name}</h4>
            <p>{dog.title}</p>
            <span class="org__breed">{dog.breed}</span>
          </li>
        ))}
      </ul>
    </div>
    <svg
      class="org__connectors"
      viewBox="0 0 600 84"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M150 0V22H450V0M300 22V62M150 84V62H450V84" />
      <circle cx="300" cy="42" r="5" />
    </svg>
    <div class="org__tier org__tier--staff">
      <p class="org__tier-label">Staff</p>
      <ul class="org__row" role="list">
        {orgChart.staff.map((name) => (
          <li class="org__person org__person--staff">
            <Icon name="work" />
            <h4>{name}</h4>
          </li>
        ))}
      </ul>
    </div>
    <p class="org__duties">
      <span>Staff responsibilities</span>
      {orgChart.staffDuties}
    </p>
  </div>
</figure>
