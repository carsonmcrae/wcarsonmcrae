---
/**
 * Purpose: A single moment in both Timeline and Posts presentations.
 * Scope: Semantic metadata, comfortable title/caption spacing, artwork, and shared actions.
 * Does NOT belong: Grouping, storage, or interaction controllers.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import type { TimelinePost } from '../data/timeline';
import { withBase } from '../lib/paths';
import PostMedia from './PostMedia.astro';
import PostActions from './PostActions.astro';
import PostMeta from './PostMeta.astro';
interface Props {
  post: TimelinePost;
}
const { post } = Astro.props;
---

<article
  class:list={[
    'post-card',
    {
      'post-card--milestone': post.milestone,
      'post-card--illustrated': post.image || post.project,
    },
  ]}
  id={`moment-${post.id}`}
  data-moment={post.id}
  data-date={post.date}
  data-category={post.category}
  data-milestone={String(Boolean(post.milestone))}
>
  <div class="post-card__copy">
    <PostMeta post={post} />
    <h3>
      <a href={withBase(`/posts/${post.id}/`)}>{post.title}</a>
    </h3>
    {post.caption && <p class="post-card__caption">{post.caption}</p>}
  </div>
  <PostMedia post={post} />
  <PostActions id={post.id} title={post.title} />
</article>
