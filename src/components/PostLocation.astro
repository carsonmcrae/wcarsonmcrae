---
/**
 * Purpose: Browse actual moments from within a permanent post page.
 * Scope: Native event slider, title/date preview, and a link back to the full timeline.
 * Does NOT belong: Navigation events (src/lib/post-navigation.ts) or content.
 */
import { timelinePosts } from '../data/timeline';
import { dateLabel, monthIndex } from '../lib/timeline-dates';
import { chronological } from '../lib/timeline-model';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
interface Props {
  id: string;
  date: string;
}
const { id, date } = Astro.props;
const ordered = chronological(timelinePosts).toReversed();
const index = ordered.findIndex((post) => post.id === id);
---

<nav class="post-location" aria-label="Moment on the full timeline" data-post-browser={id}>
  <label for="post-time" class="post-location__label">
    Browse timeline moments
  </label>
  <div class="post-location__dates">
    <span>{dateLabel(ordered[0]!.date)}</span>
    <span>{dateLabel(ordered.at(-1)!.date)}</span>
  </div>
  <input
    id="post-time"
    type="range"
    class="enhancement"
    disabled
    min={monthIndex(ordered[0]!.date)}
    max={monthIndex(ordered.at(-1)!.date)}
    step="1"
    value={monthIndex(date)}
    list="post-moments"
    aria-label="Browse timeline moments"
    aria-valuetext={`${ordered[index]!.title}, ${dateLabel(date)}`}
  />
  <datalist id="post-moments">
    {ordered.map((post) => (
      <option
        value={monthIndex(post.date)}
        label={`${post.title} · ${dateLabel(post.date)}`}
        data-id={post.id}
        data-href={withBase(`/posts/${post.id}/`)}
      />
    ))}
  </datalist>
  <output for="post-time">
    {ordered[index]!.title} · {dateLabel(date)}
  </output>
  <a href={withBase(`/?date=${date.slice(0, 7)}#moment-${id}`)} data-return-timeline>
    <Icon name="timeline" />
    See this moment on the full timeline
  </a>
</nav>
<script>
  import { initPostNavigation } from '../lib/post-navigation';
  initPostNavigation(document, (href) => window.location.assign(href));
</script>
