---
/**
 * Purpose: Three photographic milestones above the main timeline.
 * Scope: Approved pin dates, accessible jump links, and the continuous native date slider.
 * Does NOT belong: Slider behavior (src/lib/timeline-controller.ts) or event content.
 */
import { timelinePosts } from '../data/timeline';
import { dateLabel, monthIndex } from '../lib/timeline-dates';
import { chronological } from '../lib/timeline-model';
import { withBase } from '../lib/paths';
import MomentImage from './MomentImage.astro';
const pins = timelinePosts.filter((post) => post.pinned);
const newest = chronological(timelinePosts)[0]!;
const oldest = pins[0]!;
---

<section class="pinned-moments" aria-labelledby="pinned-title">
  <div class="pinned-moments__heading">
    <h2 id="pinned-title">Pinned moments</h2>
    <p>
      {dateLabel(oldest.date)} – {dateLabel(pins.at(-1)!.date)}
    </p>
  </div>
  <ul role="list" class="pinned-moments__grid">
    {pins.map((post) => (
      <li>
        <a href={withBase(`/posts/${post.id}/`)} data-jump-date={post.date}>
          <MomentImage name={post.image!} alt={post.imageAlt!} eager />
          <time datetime={post.date}>{dateLabel(post.date)}</time>
          <span class="pinned-moments__title">{post.title}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="date-rail enhancement" data-date-rail>
    <div class="date-rail__labels">
      {pins.map((post, index) => (
        <button
          type="button"
          class={`date-rail__label date-rail__label--${index}`}
          data-jump-date={post.date}
        >
          <span class="visually-hidden">Go to {post.title}, </span>
          <span class="date-rail__long">{dateLabel(post.date)}</span>
          <span class="date-rail__short">{dateLabel(post.date, true)}</span>
        </button>
      ))}
    </div>
    <label class="visually-hidden" for="timeline-range">
      Explore Carson’s timeline by date
    </label>
    <input
      id="timeline-range"
      type="range"
      min={monthIndex(oldest.date)}
      max={monthIndex(newest.date)}
      value={monthIndex(newest.date)}
      step="1"
      aria-valuetext={dateLabel(newest.date)}
      data-date-slider
    />
    <output class="date-rail__preview" for="timeline-range" data-date-preview hidden>
      {dateLabel(newest.date)}
    </output>
  </div>
</section>
