---
/**
 * Purpose: A photographic overview of Carson’s software projects.
 * Scope: Actual interface covers, app identities, statuses, details, and paired compact destination controls.
 * Does NOT belong: Project facts or timeline post definitions.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { timelinePosts } from '../data/timeline';
import { getProjectImage } from '../lib/images';
import { joinList } from '../lib/text';
import Markdown from './Markdown.astro';
import PostMedia from './PostMedia.astro';
import Icon from './Icon.astro';
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<ul role="list" class="projects">
  {projects.map((project) => {
    const icon = getProjectImage(project.icon);
    const post = timelinePosts.find((moment) => moment.id === project.postId)!;
    const primary = project.links[0]!;
    return (
      <li class="project" id={detailed ? project.id : undefined}>
        <PostMedia post={post} />
        <div class="project__content">
          <div class="project__identity">
            <h3>
              {icon && <Image src={icon} alt="" width={36} height={36} />}
              <span>{project.name}</span>
            </h3>
            <span class="project__status">{project.status}</span>
          </div>
          <p class="project__tagline">{project.tagline}</p>
          <Markdown text={project.description} />
          {detailed && (
            <details class="project__details">
              <summary>More about {project.name}</summary>
              {project.note && <Markdown text={project.note} />}
              <p class="small muted">Built with {joinList(project.stack)}.</p>
            </details>
          )}
          <div class="project__actions">
            <a
              class="project__action"
              href={primary.href}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="0"
            >
              Visit app
              <span class="visually-hidden">
                {' '}
                {project.name} (external site, opens in a new tab)
              </span>
            </a>
            <details class="project__more" data-disclosure-menu>
              <summary class="project__action" aria-label={`More links for ${project.name}`}>
                More <Icon name="chevron" />
              </summary>
              <nav class="project__more-panel" aria-label={`More links for ${project.name}`}>
                <ul role="list">
                  {project.links.slice(1).map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener noreferrer" tabindex="0">
                        {link.label}
                        <span class="visually-hidden"> (external site, opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          </div>
        </div>
      </li>
    );
  })}
</ul>
<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .project {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background: var(--surface);
  }
  .project + .project {
    margin-top: 0;
  }
  .project :global(> .post-media) {
    --media-height: 16rem;
    min-height: 15rem;
    height: 16rem;
    border-radius: 0;
    border-bottom: 1px solid var(--rule);
  }
  .project__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
  }
  .project__identity {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .project__identity h3 {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.25rem;
    margin: 0;
  }
  .project__identity img {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9px;
  }
  .project__status {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    background: var(--selected);
    color: var(--link);
    border-radius: 6px;
    font-size: 0.6875rem;
    font-weight: 650;
  }
  .project__tagline {
    font-size: 0.9375rem;
    font-weight: 650;
  }
  .project__content :global(> p:not(.project__tagline)) {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .project__details {
    font-size: 0.875rem;
  }
  .project__details summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    font-weight: 600;
    cursor: pointer;
  }
  .project__details p {
    margin-top: 0.65rem;
  }
  .project__actions {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 6.5rem), 1fr));
    grid-auto-rows: 1fr;
    gap: 0.5rem;
    width: min(100%, 15rem);
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .project__action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    min-height: 2.75rem;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--control);
    border-radius: 9px;
    background: var(--wash);
    color: var(--link);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
  }
  .project__more summary {
    list-style: none;
    cursor: pointer;
  }
  .project__more summary::-webkit-details-marker {
    display: none;
  }
  .project__more[open] > summary {
    border-color: var(--link);
    background: var(--selected);
  }
  .project__more-panel {
    position: absolute;
    inset-inline: 0;
    bottom: calc(100% + 0.5rem);
    z-index: 5;
    max-height: min(16rem, 55dvh);
    overflow-y: auto;
    padding: 0.35rem;
    border: 1px solid var(--control);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 0.5rem 1.5rem #09101d18;
  }
  .project__more-panel li + li {
    margin: 0;
  }
  .project__more-panel a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-decoration: none;
  }
  @media (hover: hover) {
    .project__action:hover {
      border-color: var(--link);
      background: var(--selected);
    }
    .project__more-panel a:hover {
      background: var(--wash);
    }
  }
  @media (max-width: 40rem) {
    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
