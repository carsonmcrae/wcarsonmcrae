---
/**
 * Purpose: Compact decorative references to the page’s shared Phosphor symbols.
 * Scope: Decorative SVG icons sized by CSS and their shared symbols; controls supply accessible labels.
 * Does NOT belong: SVG definitions or brand assets.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import type { IconName } from '../lib/icons';
import { withBase } from '../lib/paths';
interface Props {
  name: IconName;
}
const { name } = Astro.props;
---

<svg class="icon" aria-hidden="true">
  <use href={`${withBase('/icons.svg')}#icon-${name}`} />
</svg>
<style is:global>
  .icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 1.25em;
    height: 1.25em;
    fill: currentColor;
  }
</style>
