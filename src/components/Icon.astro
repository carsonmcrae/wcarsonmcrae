---
/**
 * Purpose: Compact decorative references to the page’s shared Phosphor symbols.
 * Scope: Non-focusable SVG icons; controls supply their visible and accessible labels.
 * Does NOT belong: SVG definitions or brand assets.
 */
import type { IconName } from '../lib/icons';
interface Props {
  name: IconName;
}
const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
  <use href={`#icon-${name}`} />
</svg>
<style is:global>
  .icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 1.25em;
    height: 1.25em;
  }
  .icon {
    fill: currentColor;
  }
</style>
