---
/**
 * Purpose: An approved photograph with optional caption and related moment.
 * Scope: A responsive, enlargeable photographic figure using the shared PhotoLink.
 * Does NOT belong: Choosing or approving photos (docs/CONTENT.md) or stripping metadata
 *   (scripts/strip-image-metadata.ts).
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import PhotoLink from './PhotoLink.astro';

interface Props {
  name: string;
  alt: string;
  caption?: string;
  size?: 'avatar' | 'medium';
  postId?: string;
  album?: string;
  viewerCaption?: string;
}

const { name, alt, caption, postId, album, viewerCaption, size = 'medium' } = Astro.props;
---

{
  <figure class:list={['photo', `photo--${size}`]} data-image-frame>
    <PhotoLink
      name={name}
      alt={alt}
      {...(postId ? { postId } : {})}
      {...(album ? { album } : {})}
      {...(viewerCaption ? { caption: viewerCaption } : {})}
    />
    {caption && <figcaption class="small muted">{caption}</figcaption>}
  </figure>
}

<style>
  .photo :global(img) {
    border-radius: 4px;
  }

  .photo--avatar :global(img) {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .photo--medium {
    max-width: 24rem;
  }

  .photo figcaption {
    margin-top: 0.5rem;
  }

  :global([data-image-failed]).photo {
    display: none;
  }
</style>
