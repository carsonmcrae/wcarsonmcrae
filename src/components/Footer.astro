---
/**
 * Purpose: Keep essential site choices close in a compact, recognizable footer.
 * Scope: Approved identity, privacy/settings/accessibility/releases, More destinations, and quiet legal text.
 * Does NOT belong: The separate browser-storage banner, header navigation, or consent behavior.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import { footer, navigation, site } from '../data/site';
import { profile } from '../data/profile';
import { brand } from '../data/brand';
import { currentVersion } from '../data/releases';
import { withBase } from '../lib/paths';
import { formatDate } from '../lib/text';
import Icon from './Icon.astro';
import '../styles/footer.css';
const built = new Date();
const resources = [
  { label: 'Accessibility', href: '/accessibility/', icon: 'accessibility' as const },
  { label: `Releases v${currentVersion}`, href: '/releases/', icon: 'release' as const },
];
---

<footer class="site-footer">
  <div class="site-footer__identity">
    <a
      class="site-footer__brand"
      href={withBase('/')}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Daysforth (opens in a new tab)"
    >
      <img src={withBase('/brand/daysforth-mark.svg')} alt="" width="32" height="32" />
      {brand.name}
    </a>
    <p>{footer.signature}</p>
  </div>
  <nav class="site-footer__actions" aria-label="Footer">
    <a
      href={withBase('/privacy/')}
      target="_blank"
      rel="noopener noreferrer"
      tabindex="0"
      aria-label="Privacy (opens in a new tab)"
    >
      <Icon name="privacy" />
      Privacy
    </a>
    <button
      class="storage-settings enhancement"
      type="button"
      data-storage-open
      aria-label="Settings for browser storage"
    >
      <Icon name="storage" />
      Settings
    </button>
    {resources.map((resource) => (
      <a
        href={withBase(resource.href)}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="0"
        aria-label={`${resource.label} (opens in a new tab)`}
      >
        <Icon name={resource.icon} />
        {resource.label}
      </a>
    ))}
    <details class="site-footer__more" data-disclosure-menu>
      <summary>
        More <Icon name="chevron" />
      </summary>
      <nav class="site-footer__menu-panel" aria-label="More footer links">
        <ul role="list">
          {navigation.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="0"
                aria-label={`${item.label} (opens in a new tab)`}
              >
                <Icon name={item.icon} />
                <span>{item.label}</span>
                <Icon name="arrowRight" />
              </a>
            </li>
          ))}
          <li>
            <a
              href={withBase('/brand/')}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="0"
              aria-label="Brand kit (opens in a new tab)"
            >
              <Icon name="portfolio" />
              <span>Brand kit</span>
              <Icon name="arrowRight" />
            </a>
          </li>
          <li>
            <a href={site.repositoryUrl} target="_blank" rel="noopener noreferrer" tabindex="0">
              <Icon name="github" />
              <span>Source on GitHub</span>
              <Icon name="arrowRight" />
              <span class="visually-hidden"> (external site, opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </nav>
  <div class="site-footer__legal">
    <p>
      © {built.getFullYear()} {profile.name}. {footer.disclaimer}
    </p>
    <p>
      Updated <time datetime={built.toISOString().slice(0, 10)}>{formatDate(built)}</time>
    </p>
  </div>
</footer>
