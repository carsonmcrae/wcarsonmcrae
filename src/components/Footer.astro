---
/**
 * Purpose: A clear footer with the Daysforth identity and organized navigation.
 * Scope: Primary destinations, brand/accessibility/source resources, the sign-off, and build date.
 * Does NOT belong: Main header navigation or private contact information.
 */
import { footer, navigation, site } from '../data/site';
import { profile } from '../data/profile';
import { brand } from '../data/brand';
import { withBase } from '../lib/paths';
import { formatDate } from '../lib/text';
import Icon from './Icon.astro';
const built = new Date();
---

<footer class="site-footer page">
  <div class="site-footer__top">
    <div class="site-footer__identity">
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="site-footer__brand"
        href={withBase('/')}
        aria-label="Daysforth (opens in a new tab)"
      >
        <img src={withBase('/brand/daysforth-mark.svg')} alt="" width="28" height="28" />
        {brand.name}
      </a>
      <p>{footer.signature}</p>
    </div>
    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul role="list">
        {navigation.map((item) => (
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={withBase(item.href)}
              tabindex="0"
              aria-label={`${item.label} (opens in a new tab)`}
            >
              <Icon name={item.icon} />
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Resources">
      <h2>More</h2>
      <ul role="list">
        <li>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={withBase('/brand/')}
            tabindex="0"
            aria-label="Brand kit (opens in a new tab)"
          >
            Brand kit
            <Icon name="arrowRight" />
          </a>
        </li>
        <li>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={withBase('/accessibility/')}
            aria-label="Accessibility (opens in a new tab)"
            tabindex="0"
          >
            Accessibility
            <Icon name="arrowRight" />
          </a>
        </li>
        <li>
          <a target="_blank" rel="noopener noreferrer" href={site.repositoryUrl} tabindex="0">
            Source
            <Icon name="github" />
            <span class="visually-hidden"> on GitHub (external site, opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="site-footer__bottom">
    <a
      target="_blank"
      rel="noopener noreferrer"
      href={withBase('/privacy/')}
      aria-label="Privacy (opens in a new tab)"
    >
      Privacy
    </a>
    <button class="control enhancement" data-storage-open>
      Storage settings
    </button>
    <p>
      © {built.getFullYear()} {profile.name}. {footer.disclaimer}
    </p>
    <p>
      Updated <time datetime={built.toISOString().slice(0, 10)}>{formatDate(built)}</time>
    </p>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: var(--section);
    padding-block: 2.5rem 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
  }
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 750;
    text-decoration: none;
    letter-spacing: -0.035em;
  }
  .site-footer__brand:visited {
    color: var(--text);
  }
  .site-footer__brand img {
    width: 1.75rem;
    height: 1.75rem;
  }
  .site-footer__identity p {
    margin-top: 0.75rem;
    max-width: 14rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  nav h2 {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  nav ul {
    display: grid;
  }
  nav li + li {
    margin: 0;
  }
  nav a,
  nav a:visited {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.8125rem;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.75rem;
  }
  @media (hover: hover) {
    nav a:hover {
      color: var(--link);
      text-decoration: underline;
    }
  }
  .site-footer__bottom > a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
  }
  @media (max-width: 40rem) {
    .site-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
    .site-footer__identity {
      grid-column: 1 / -1;
    }
    .site-footer__identity p {
      max-width: none;
    }
  }
</style>
