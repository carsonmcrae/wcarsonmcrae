---
/**
 * Purpose: A consistently linked post cover with discoverable open and album affordances.
 * Scope: Responsive photography or app art, a 44px expand affordance, and a photo-count indicator.
 * Does NOT belong: Content, galleries, or navigation behavior.
 */
import type { TimelinePost } from '../data/timeline';
import { postMedia } from '../lib/post-media';
import { withBase } from '../lib/paths';
import MomentImage from './MomentImage.astro';
import Icon from './Icon.astro';
interface Props {
  post: TimelinePost;
}
const { post } = Astro.props;
const media = postMedia(post);
---

<a
  class:list={['post-media', `post-media--${media.kind}`]}
  href={withBase(`/posts/${post.id}/`)}
  aria-label={`View post: ${post.title}${media.count > 1 ? ` · ${media.count} photos` : ''}`}
>
  <MomentImage name={media.name} alt={media.alt} kind={media.kind} />
  {post.project && (
    <span class="post-media__app" aria-hidden="true">
      <MomentImage name={post.project} alt="" kind="project" />
    </span>
  )}
  {media.count > 1 && (
    <span class="post-media__count" aria-hidden="true">
      <Icon name="images" />
      {media.count}
    </span>
  )}
  <span class="post-media__open" aria-hidden="true">
    <Icon name="expand" />
  </span>
</a>
