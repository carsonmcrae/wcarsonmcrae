---
/**
 * Purpose: Shared visual and screen-reader feedback for moment actions.
 * Scope: A permanently mounted live region and a separately dismissible visual notice.
 * Does NOT belong: Timing (src/lib/notices.ts) or Save/Copy/reaction behavior.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
---

<p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-action-live></p>
<div class="action-notice" data-action-notice hidden>
  <span data-notice-text></span>
  <button type="button" aria-label="Dismiss notification" data-dismiss-notice>
    Dismiss
  </button>
</div>
<script>
  import { startPostActions } from '../scripts/actions';
  startPostActions();
</script>
