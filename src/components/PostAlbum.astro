import type { PostPhoto } from '../data/timeline';
import PhotoLink from './PhotoLink.astro';
interface Props {
  photos: PostPhoto[];
}
const { photos } = Astro.props;
---

<section class="post-album" aria-label="More photos from this moment">
  {photos.map((photo) => (
    <figure>
      <PhotoLink
        name={photo.name}
        alt={photo.alt}
        caption={photo.caption}
        {...(photo.postId ? { postId: photo.postId } : {})}
      />
      <figcaption>{photo.caption}</figcaption>
    </figure>
  ))}
</section>
