---
/**
 * Purpose: Enlarge approved photography without losing a useful native-link fallback.
 * Scope: Optimized large image URL, accessible trigger, and optional related moment.
 * Does NOT belong: Dialog behavior, content approval, or card overlays.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import { getImage } from 'astro:assets';
import { getPhoto, getProjectImage } from '../lib/images';
import { withBase } from '../lib/paths';
import MomentImage from './MomentImage.astro';
import Icon from './Icon.astro';
import { photoReactionId } from '../lib/photo-reaction-id';
interface Props {
  name: string;
  alt: string;
  kind?: 'photo' | 'screen';
  eager?: boolean;
  sizes?: string;
  widths?: number[];
  postId?: string;
  caption?: string;
  class?: string;
  album?: string;
  label?: string;
}
const {
  name,
  alt,
  kind = 'photo',
  eager = false,
  sizes,
  widths,
  postId,
  caption = alt,
  class: className,
  album,
  label,
} = Astro.props;
const source = kind === 'photo' ? getPhoto(name) : getProjectImage(name);
const large = source
  ? await getImage({
      src: source,
      width: Math.min(source.width, 1000),
      format: 'webp',
      quality: 58,
    })
  : null;
---

{large && (
  <a
    href={large.src}
    class:list={['photo-open', className]}
    aria-label={label ? undefined : alt}
    data-photo={photoReactionId(name, kind)}
    data-photo-album={album}
    data-photo-alt={label ? alt : undefined}
    data-photo-caption={caption === alt ? undefined : caption}
    data-photo-post={postId ? withBase(`/posts/${postId}/`) : undefined}
  >
    {label ? (
      <>
        <Icon name="images" />
        <span>{label}</span>
      </>
    ) : (
      <>
        <MomentImage
          name={name}
          alt={alt}
          kind={kind}
          eager={eager}
          {...(sizes === undefined ? {} : { sizes })}
          {...(widths === undefined ? {} : { widths })}
        />
      </>
    )}
  </a>
)}
