---
/**
 * Purpose: A native, keyboard-accessible large-photo viewer shared across the app.
 * Scope: Photo, album controls, caption, related-post destination, and visible close action.
 * Does NOT belong: Album content, navigation behavior, or storage.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
import { reactions } from '../data/reactions';
import '../styles/photo-viewer.css';
---

<dialog class="photo-viewer" data-photo-viewer aria-labelledby="photo-viewer-title">
  <p id="photo-viewer-title" class="visually-hidden">
    Photo viewer
  </p>
  <div class="photo-viewer__header">
    <button
      type="button"
      class="photo-viewer__close control"
      data-photo-close
      aria-label="Close photo viewer"
    >
      Close <span aria-hidden="true">×</span>
    </button>
    <p class="photo-viewer__position" data-photo-count hidden></p>
  </div>
  <div class="photo-viewer__body">
    <div class="photo-viewer__media">
      <figure data-photo-stage aria-describedby="photo-caption">
        <img data-photo-large alt="" />
      </figure>
      <nav class="photo-viewer__navigation" aria-label="Photo navigation">
        <button type="button" class="control" data-photo-previous hidden>
          <Icon name="arrow" /> Previous
        </button>
        <button type="button" class="control" data-photo-next hidden>
          Next <Icon name="arrowRight" />
        </button>
      </nav>
      <div
        class="photo-viewer__strip"
        data-photo-strip
        role="group"
        aria-label="Photos in this album"
        hidden
      ></div>
    </div>
    <section class="photo-viewer__details" aria-label="About this photo">
      <div class="photo-viewer__caption" role="region" aria-label="Photo caption" tabindex="0">
        <p class="photo-viewer__eyebrow">A moment along the way</p>
        <p id="photo-caption" data-photo-caption-output></p>
      </div>
      <div class="photo-viewer__social">
        <p class="photo-viewer__eyebrow">Leave a little love</p>
        <div
          class="photo-viewer__reactions"
          data-photo-reactions
          role="group"
          aria-label="Photo reactions"
        >
          {reactions.map((reaction) => (
            <button type="button" data-photo-react={reaction.id} aria-pressed="false" disabled>
              <Icon name={reaction.icon} />
              <span>{reaction.label}</span> <span data-photo-reaction-count>—</span>
            </button>
          ))}
        </div>
        <p
          class="photo-viewer__status"
          data-photo-reaction-status
          role="status"
          aria-live="polite"
        ></p>
      </div>
      <div class="photo-viewer__related">
        <a href={withBase('/')} class="destination-link" data-photo-related hidden>
          <Icon name="arrowRight" />
          View this moment
        </a>
      </div>
    </section>
  </div>
  <p
    class="visually-hidden"
    data-photo-announcement
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
</dialog>
