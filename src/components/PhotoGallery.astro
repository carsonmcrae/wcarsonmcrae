---
/**
 * Purpose: An editorial gallery of Carson’s actual approved photographs.
 * Scope: Responsive image pairs with clear alternatives and captions.
 * Does NOT belong: Content, dates, photo approval, or image processing.
 */
import type { GalleryPhoto } from '../data/photo-gallery';
import Photo from './Photo.astro';
import { withBase } from '../lib/paths';
interface Props {
  photos: GalleryPhoto[];
}
const { photos } = Astro.props;
---

<div class="photo-gallery">
  {photos.map((photo) => (
    <a href={withBase(`/posts/${photo.postId}/`)} class="photo-gallery__link">
      <Photo name={photo.name} alt={photo.alt} caption={photo.caption} />
      <span class="visually-hidden">View the post</span>
    </a>
  ))}
</div>
<style>
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .photo-gallery :global(.photo) {
    width: 100%;
    max-width: none;
  }
  .photo-gallery :global(img) {
    width: 100%;
    height: 16rem;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: 12px;
  }
  @media (max-width: 30rem) {
    .photo-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
