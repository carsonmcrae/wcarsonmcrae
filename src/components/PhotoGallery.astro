---
/**
 * Purpose: An editorial gallery of Carson’s actual approved photographs.
 * Scope: Caption-free previews linked to complete albums in the shared larger viewer.
 * Does NOT belong: Content, dates, photo approval, or image processing.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import type { GalleryPhoto } from '../data/photo-gallery';
import PhotoLink from './PhotoLink.astro';
import '../styles/photo-albums.css';
interface Props {
  photos: GalleryPhoto[];
  id: string;
  preview?: boolean;
  skipCover?: boolean;
  layout?: 'album' | 'pairs';
}
const { photos, id, preview = false, skipCover = false, layout = 'album' } = Astro.props;
---

<ul
  class:list={[
    'photo-gallery',
    `photo-gallery--${layout}`,
    { 'photo-gallery--preview': preview, 'photo-gallery--after-cover': skipCover },
  ]}
  role="list"
>
  {photos.map((photo, index) => (
    <li class="photo-gallery__item">
      <figure class="photo" data-image-frame>
        <PhotoLink
          name={photo.name}
          kind={photo.imageKind ?? 'photo'}
          alt={photo.alt}
          caption={photo.caption}
          album={id}
          {...(photo.postId ? { postId: photo.postId } : {})}
        />
      </figure>
      {preview && index === (skipCover ? 3 : 2) && photos.length > 3 && (
        <span class="album-preview__remaining" aria-hidden="true">
          +{photos.length - (skipCover ? 4 : 3)}
        </span>
      )}
    </li>
  ))}
</ul>
<style>
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .photo-gallery__item {
    min-width: 0;
    margin: 0;
  }
  .photo-gallery--pairs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .photo-gallery :global(.photo) {
    width: 100%;
    max-width: none;
  }
  .photo-gallery :global(img) {
    width: 100%;
    height: 15rem;
    object-fit: contain;
    background: var(--wash);
    border-radius: 12px;
  }
  .photo-gallery--pairs :global(img) {
    height: 20rem;
  }
  @media (max-width: 48rem) {
    .photo-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 30rem) {
    .photo-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .photo-gallery :global(img) {
      height: 19rem;
    }
  }
</style>
