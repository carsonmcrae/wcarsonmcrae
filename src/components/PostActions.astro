---
/**
 * Purpose: Shared social actions on a moment and its permalink.
 * Scope: Accessible reactions, browser-local Save, Copy link, and honest initial availability.
 * Does NOT belong: Storage and network calls (src/lib/post-actions.ts).
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import { absoluteUrl } from '../lib/paths';
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div
  class="post-actions enhancement"
  data-post-actions={id}
  data-post-title={title}
  data-post-url={absoluteUrl(`/posts/${id}/`, Astro.site!.origin)}
></div>
