---
/**
 * Purpose: Daysforth’s product header and primary navigation.
 * Scope: Brand, active page, responsive disclosure, and visibly labelled theme control.
 * Does NOT belong: Menu/theme behavior (src/lib) or profile content.
 */
import { brand } from '../data/brand';
import { navigation } from '../data/site';
import { isActivePath, withBase } from '../lib/paths';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__name" href={withBase('/')}>
      <img src={withBase('/brand/daysforth-mark.svg')} width="32" height="32" alt="" />
      <span>{brand.name}</span>
    </a>
    <button
      type="button"
      class="control site-header__menu"
      data-menu-toggle
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <Icon name="menu" />
      Menu
    </button>
    <div class="site-header__menu-panel" id="site-menu">
      <nav aria-label="Main">
        <ul role="list">
          {navigation.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                tabindex="0"
                aria-current={isActivePath(currentPath, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    width: min(100% - 2 * var(--gutter), 72rem);
    min-height: 3.5rem;
    margin-inline: auto;
  }
  .site-header__name {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    color: var(--text);
    font-size: 1.625rem;
    font-weight: 780;
    letter-spacing: -0.055em;
    text-decoration: none;
  }
  .site-header__name:visited {
    color: var(--text);
  }
  .site-header__name img {
    width: 2rem;
    height: 2rem;
  }
  .site-header__menu-panel {
    position: relative;
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-right: 7.5rem;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
  }
  nav li + li {
    margin-top: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 3.5rem;
    min-width: 2.75rem;
    padding-inline: 0.65rem;
    border-bottom: 3px solid transparent;
    color: var(--text);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  nav a:visited {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--link);
    font-weight: 650;
    border-bottom-color: var(--link);
  }
  .site-header__menu {
    display: none;
    margin-left: auto;
  }
  :global(.site-header .theme-toggle) {
    position: absolute;
    right: 0;
  }
  @media (hover: hover) {
    nav a:hover {
      color: var(--link);
    }
  }
  @media (max-width: 39.99rem) {
    .site-header__inner {
      min-height: 3rem;
      padding-block: 0.125rem;
    }
    .site-header__name {
      font-size: 1.5rem;
    }
    .site-header__menu-panel {
      flex-basis: 100%;
      align-items: stretch;
      justify-content: flex-start;
      padding: 0 0 0.5rem;
    }
    nav ul {
      flex-direction: column;
      align-items: stretch;
    }
    nav a {
      min-height: 2.75rem;
      padding-inline: 0;
      border-bottom: 0;
    }
    nav {
      width: 100%;
    }
    :global(html.js) .site-header__menu {
      display: inline-flex;
    }
    :global(html.js) .site-header__menu-panel:not([data-open='true']) {
      display: none;
    }
    :global(.site-header .theme-toggle) {
      position: static;
      align-self: flex-start;
    }
  }
</style>
