---
/**
 * Purpose: The visibly labelled light/dark theme switch.
 * Scope: The moon icon and pressed state; the operating-system theme still works without JavaScript.
 * Does NOT belong: Theme behavior or palette definitions.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import Icon from './Icon.astro';
---

<button
  type="button"
  class="control theme-toggle enhancement"
  data-theme-toggle
  aria-pressed="false"
>
  <Icon name="moon" />
  Dark mode
</button>
<style>
  .theme-toggle {
    font-size: 0.75rem;
  }
  .theme-toggle[aria-pressed='true'] {
    background: var(--selected);
    color: var(--link);
  }
</style>
