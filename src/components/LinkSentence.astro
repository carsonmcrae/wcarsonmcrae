---
/**
 * Purpose: Writes a set of links as an English list inside a sentence ("a, b, and c").
 * Scope: Internal links get the base path; external links get a screen-reader note. Separators come
 *   from src/lib/text.ts.
 * Does NOT belong: Choosing which links to show (the calling component).
 */
import type { LinkItem } from '../data/types';
import { isExternalUrl, withBase } from '../lib/paths';
import { listSeparator } from '../lib/text';

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props;
---

{links.map((link, index) => {
  const external = isExternalUrl(link.href);
  return (
    <>
      {listSeparator(index, links.length)}
      <a href={external ? link.href : withBase(link.href)} rel={external ? 'noopener' : undefined}>
        {link.label}
        {external && <span class="visually-hidden"> (external site)</span>}
      </a>
    </>
  );
})}
