---
/**
 * Purpose: Carson’s Daysforth profile, where the profile is the timeline.
 * Scope: The approved centered profile, three pinned moments, and switchable timeline/posts feed.
 * Does NOT belong: Personal content or interaction logic.
 */
import PinnedMoments from '../components/PinnedMoments.astro';
import ProfileSummary from '../components/ProfileSummary.astro';
import TimelineFeed from '../components/TimelineFeed.astro';
import { pages } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/profile.css';
import '../styles/timeline.css';
import '../styles/timeline-controls.css';
---

<BaseLayout page={pages.home}>
  <div class="profile-overview">
    <ProfileSummary />
    <PinnedMoments />
  </div>
  <TimelineFeed />
</BaseLayout>
