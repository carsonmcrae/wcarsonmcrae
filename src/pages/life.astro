---
/**
 * Purpose: Carson’s personal life presented through linked stories and photographs.
 * Scope: Family, dogs, interests, timeline-linked albums, and the approved right-now list.
 * Does NOT belong: Personal facts, image processing, or invented event dates.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import DogEntry from '../components/DogEntry.astro';
import Markdown from '../components/Markdown.astro';
import OrgChart from '../components/OrgChart.astro';
import SecondaryHero from '../components/SecondaryHero.astro';
import PostMedia from '../components/PostMedia.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import Icon from '../components/Icon.astro';
import { dogGalleries, lifePhotos } from '../data/photo-gallery';
import Section from '../components/Section.astro';
import { dogs, dogsIntro, interests, interestsIntro, lifeIntro, nicole, now } from '../data/life';
import { timelinePosts } from '../data/timeline';
import { pages } from '../data/site';
import { withBase } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/secondary.css';
import '../styles/post-media.css';
const wedding = timelinePosts.find((post) => post.id === 'married-nicole')!;
---

<BaseLayout page={pages.life}>
  <div class="secondary-page">
    <SecondaryHero label="Life" title={lifeIntro.title} lede={lifeIntro.lede}>
      <aside slot="media" class="now-panel" aria-labelledby="now-heading">
        <h2 id="now-heading">{now.title}</h2>
        <p class="small muted">Updated {now.updated}</p>
        <dl>
          {now.items.map((item) => (
            <>
              <dt>{item.label}</dt>
              <Markdown text={item.value} as="dd" />
            </>
          ))}
        </dl>
      </aside>
    </SecondaryHero>
    <Section title={nicole.title} id="nicole" wide>
      <div class="story-feature">
        <PostMedia post={wedding} showCount={false} />
        <div class="story-feature__copy">
          {nicole.body.map((paragraph) => (
            <Markdown text={paragraph} />
          ))}
          <a class="destination-link" href={withBase('/posts/married-nicole/')}>
            <Icon name="images" />
            The wedding, with friends
            <Icon name="arrowRight" />
          </a>
        </div>
      </div>
    </Section>
    <Section title={dogsIntro.title} id="dogs" lede={dogsIntro.lede} wide>
      <div class="dogs content-grid">
        {dogs.map((dog, index) => (
          <DogEntry dog={dog} album={dogGalleries[index]!} />
        ))}
      </div>
      <OrgChart />
    </Section>
    <Section title="Out and about" id="photos" wide>
      <PhotoGallery photos={lifePhotos} id="life-photos" layout="pairs" />
    </Section>
    <Section title={interestsIntro.title} id="interests" lede={interestsIntro.lede} wide>
      <dl class="interest-cards">
        {interests.map((interest) => (
          <div id={interest.id}>
            <dt>{interest.name}</dt>
            <Markdown text={interest.detail} as="dd" />
          </div>
        ))}
      </dl>
    </Section>
  </div>
</BaseLayout>
