---
/**
 * Purpose: Make this personal site’s actual privacy and storage practices easy to inspect.
 * Scope: Navigable policy sections, provider disclosures, and access to storage controls.
 * Does NOT belong: Unverified legal guarantees or private contact details.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { privacy } from '../data/privacy';
import { withBase } from '../lib/paths';
import { fullDateLabel } from '../lib/timeline-dates';
import '../styles/privacy.css';
---

<BaseLayout
  page={{
    id: 'privacy',
    title: privacy.title,
    description:
      'Browser storage, permanent reactions, hosting, and your privacy choices on Daysforth.',
    path: '/privacy/',
  }}
>
  <div class="section privacy-page">
    <div class="privacy-intro flow">
      <p class="privacy-eyebrow">Your information & your choices</p>
      <h1>{privacy.title}</h1>
      <p class="lede">{privacy.intro}</p>
      <p class="small muted">
        Updated <time datetime={privacy.updated}>{fullDateLabel(privacy.updated)}</time>
      </p>
      <button class="control enhancement" data-storage-open>
        Storage settings
      </button>
    </div>
    <div class="privacy-layout">
      <nav class="privacy-contents" aria-label="Privacy notice sections">
        <p class="privacy-eyebrow">In this notice</p>
        <ol role="list">
          {privacy.sections.map((section) => (
            <li>
              <a href={`#${section.id}`} tabindex="0">
                {section.title}
              </a>
            </li>
          ))}
          <li>
            <a href="#providers" tabindex="0">
              Provider policies & contact
            </a>
          </li>
        </ol>
      </nav>
      <div class="privacy-sections">
        {privacy.sections.map((section) => (
          <section
            class="privacy-section flow"
            id={section.id}
            aria-labelledby={`${section.id}-title`}
          >
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p>{section.body}</p>
          </section>
        ))}
        <section class="privacy-providers flow" id="providers" aria-labelledby="providers-title">
          <h2 id="providers-title">Provider policies & contact</h2>
          <p>
            <a href={withBase('/contact/')}>Contact Carson about privacy</a>
          </p>
          <ul role="list">
            {privacy.providers.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                  <span class="visually-hidden"> (external site, opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
