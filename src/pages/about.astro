---
/**
 * Purpose: Carson’s background with a clear story, portrait, principles, and facts.
 * Scope: Preserves approved copy while organizing it into visual, readable sections.
 * Does NOT belong: Personal facts or timeline interaction logic.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import Markdown from '../components/Markdown.astro';
import SecondaryHero from '../components/SecondaryHero.astro';
import Section from '../components/Section.astro';
import Photo from '../components/Photo.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { carsonGallery } from '../data/photo-gallery';
import { about, principles, quickFacts, timeline } from '../data/career';
import { profile } from '../data/profile';
import { pages } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/secondary.css';
---

<BaseLayout page={pages.about}>
  <div class="secondary-page">
    <SecondaryHero label="About" title={about.title} lede={about.lede}>
      {about.body.map((paragraph) => (
        <Markdown text={paragraph} />
      ))}
      <Photo slot="media" name="carson-solo" alt={profile.name} />
    </SecondaryHero>
    <Section title={carsonGallery.title} id="photos" wide>
      <PhotoGallery photos={carsonGallery.photos} />
    </Section>
    <Section title="How I got here" id="timeline" wide>
      <ol role="list" class="story-timeline">
        {timeline.map((entry) => (
          <li>
            <p class="story-timeline__when">{entry.when}</p>
            <div>
              <h3>{entry.title}</h3>
              <Markdown text={entry.detail} />
            </div>
          </li>
        ))}
      </ol>
    </Section>
    <Section title={about.path.title} id="path" wide>
      <div class="surface-panel surface-panel--soft flow">
        {about.path.body.map((paragraph) => (
          <Markdown text={paragraph} />
        ))}
      </div>
    </Section>
    <Section title="How I like to work" id="principles" wide>
      <div class="content-grid">
        {principles.map((principle) => (
          <article class="surface-panel principle-card">
            <h3>{principle.title}</h3>
            <Markdown text={principle.detail} />
          </article>
        ))}
      </div>
    </Section>
    <Section title="Quick facts" id="facts" wide>
      <dl class="facts-grid">
        {quickFacts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <Markdown text="Next: [my work](/work/), or [life outside it](/life/)." class="page-note" />
    </Section>
  </div>
</BaseLayout>
