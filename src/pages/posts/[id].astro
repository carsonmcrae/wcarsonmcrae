---
/**
 * Purpose: A stable, shareable page for every timeline moment.
 * Scope: Actual date precision, associated media, context, shared actions, and adjacent moments.
 * Does NOT belong: Post content (src/data/timeline.ts) or action behavior.
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import MomentImage from '../../components/MomentImage.astro';
import PhotoLink from '../../components/PhotoLink.astro';
import Markdown from '../../components/Markdown.astro';
import PostActions from '../../components/PostActions.astro';
import PostActionTemplate from '../../components/PostActionTemplate.astro';
import ActionNotice from '../../components/ActionNotice.astro';
import PostLocation from '../../components/PostLocation.astro';
import Icon from '../../components/Icon.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostAlbum from '../../components/PostAlbum.astro';
import { profile } from '../../data/profile';
import { timelinePosts, type TimelinePost } from '../../data/timeline';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postMedia } from '../../lib/post-media';
import { chronological } from '../../lib/timeline-model';
import { withBase, isExternalUrl } from '../../lib/paths';
import '../../styles/timeline.css';
import '../../styles/post-detail.css';
import '../../styles/post-media.css';
export function getStaticPaths() {
  return timelinePosts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props {
  post: TimelinePost;
}
const { post } = Astro.props;
const ordered = chronological(timelinePosts);
const index = ordered.findIndex((item) => item.id === post.id);
const newer = ordered[index - 1];
const older = ordered[index + 1];
const media = postMedia(post);
const page = {
  id: 'post' as const,
  title: `${post.title} · ${profile.name}`,
  path: `/posts/${post.id}/`,
  description: `${post.title}. ${post.caption} A moment from ${profile.name}’s timeline on Daysforth.`,
};
---

<BaseLayout page={page}>
  <PostActionTemplate />
  <article class="post-detail">
    <a
      class="back-to-timeline destination-link"
      data-return-timeline
      href={withBase(`/?date=${post.date.slice(0, 7)}#moment-${post.id}`)}
    >
      <Icon name="arrow" />
      Back to the timeline
    </a>
    <PostMeta post={post} detail />
    <h1>{post.title}</h1>
    {post.caption && <p class="post-detail__caption">{post.caption}</p>}
    <div class={`post-detail__photo post-detail__photo--${media.kind}`}>
      {media.kind === 'project' ? (
        <MomentImage name={media.name} alt={media.alt} kind="project" eager />
      ) : (
        <PhotoLink name={media.name} alt={media.alt} kind={media.kind} eager />
      )}
    </div>
    <div class="post-detail__body flow">
      {post.body.map((paragraph) => (
        <Markdown text={paragraph} />
      ))}
    </div>
    {post.gallery && <PostAlbum photos={post.gallery} />}
    {post.links && (
      <ul class="post-detail__links" role="list">
        {post.links.map((link) => (
          <li>
            <a
              class="destination-link"
              href={isExternalUrl(link.href) ? link.href : withBase(link.href)}
              target={isExternalUrl(link.href) ? '_blank' : undefined}
              rel={isExternalUrl(link.href) ? 'noopener noreferrer' : undefined}
            >
              {link.label}
              {isExternalUrl(link.href) && (
                <span class="visually-hidden"> (external site, opens in a new tab)</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
    <PostActions id={post.id} title={post.title} />
    <PostLocation id={post.id} date={post.date} />
    <nav class="post-neighbors" aria-label="Adjacent moments">
      {older && (
        <a href={withBase(`/posts/${older.id}/`)}>
          <span>
            <Icon name="arrow" />
            Earlier moment
          </span>
          <strong>{older.title}</strong>
        </a>
      )}
      {newer && (
        <a class="post-neighbor--newer" href={withBase(`/posts/${newer.id}/`)}>
          <span>
            <Icon name="arrowRight" />
            Newer moment
          </span>
          <strong>{newer.title}</strong>
        </a>
      )}
    </nav>
  </article>
  <ActionNotice />
</BaseLayout>
