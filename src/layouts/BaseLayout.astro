---
/**
 * Purpose: The page shell every route renders inside.
 * Scope: Metadata, landmarks, secondary-page shortcuts, shared dialogs, and the progressive client entry.
 * Does NOT belong: Page content (src/pages) or metadata details (SiteHead.astro).
 * Copyright (c) 2026 William Carson McRae. All rights reserved.
 * SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
 */
import '../styles/global.css';
import PhotoViewer from '../components/PhotoViewer.astro';
import PrivacyControls from '../components/PrivacyControls.astro';
import '../styles/interaction.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SiteHead from '../components/SiteHead.astro';
import PageJumps from '../components/PageJumps.astro';
import { site, type PageMeta } from '../data/site';
import { TIMELINE_HOLD_SCRIPT } from '../lib/page-position';

interface Props {
  page: Pick<PageMeta, 'title' | 'description' | 'path'> & {
    id: PageMeta['id'] | '404' | 'post' | 'brand' | 'privacy' | 'releases' | 'release';
  };
  noindex?: boolean;
}

const { page, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={site.language} id="top">
  <head>
    <SiteHead
      page={page}
      noindex={noindex}
      includePerson={page.id === 'home'}
      includeTimelineStyles={page.id === 'home'}
      includeMediaFrames={['home', 'work', 'life'].includes(page.id)}
    />
    <script>
      import '../scripts/site.ts';
    </script>
    <slot name="head" />
  </head>
  <body data-page-id={page.id}>
    <a class="skip-link" href="#main" tabindex="0">
      Skip to content
    </a>
    <Header />
    <main id="main" class="page" tabindex="-1">
      <script is:inline set:html={TIMELINE_HOLD_SCRIPT} />
      <slot />
    </main>
    <Footer />
    {['work', 'life', 'about', 'contact'].includes(page.id) && <PageJumps />}
    <PhotoViewer />
    <PrivacyControls />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  main {
    padding-bottom: 1rem;
  }
</style>
