# Purpose: npm behaviour for this repository.
# Scope: Exact version pins, engine enforcement, the high-severity audit level, no install hooks, and a
#   14-day supply-chain cooldown on newly published versions (honoured by npm 11+; on older npm, install
#   with --before=<date 14 days ago> instead, as docs/governance/repository-rules.md explains).
# Does NOT belong: Registry credentials or tokens; never commit those.
# Copyright (c) 2026 William Carson McRae. All rights reserved.
# SPDX-License-Identifier: LicenseRef-Daysforth-Restricted
save-exact=true
engine-strict=true
fund=false
audit-level=high
# No dependency needs install hooks (audited 2026-11-03); never run them implicitly.
ignore-scripts=true
min-release-age=14
